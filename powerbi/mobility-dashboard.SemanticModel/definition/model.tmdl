model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-ID
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_zone","dim_company","fct_trips_hourly","fct_trips","dim_time"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table dim_date
ref table dim_zone
ref table dim_company
ref table fct_trips_hourly
ref table fct_trips
ref table dim_time

ref cultureInfo en-US
