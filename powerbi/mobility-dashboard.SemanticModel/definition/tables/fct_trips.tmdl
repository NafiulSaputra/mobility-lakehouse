table fct_trips
	lineageTag: 4afb6ba5-bbeb-497a-bd4d-f51d399c54d2

	measure 'Trips (trip grain)' = COUNTROWS ( fct_trips )
		formatString: 0
		lineageTag: 2b38abb5-479a-46de-b6fa-ca545317a8d5

	measure 'Airport Dropoffs (trip grain)' = ```

			        CALCULATE (
			            COUNTROWS ( fct_trips ),
			            USERELATIONSHIP ( fct_trips[dropoff_zone_key], dim_zone[zone_key] ),
			            dim_zone[is_airport] = TRUE ()
			        )
			```
		formatString: 0
		lineageTag: 05dda357-b602-4e29-8b99-9bf84e1dbe75

