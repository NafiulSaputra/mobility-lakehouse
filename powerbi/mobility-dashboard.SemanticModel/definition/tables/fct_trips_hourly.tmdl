table fct_trips_hourly
	lineageTag: 16e3d687-48a4-454c-98fa-804c7d012268

	measure 'Total Trips' = SUM ( fct_trips_hourly[trips] )
		formatString: 0
		lineageTag: 9dbf13e8-bee1-4c20-8055-40aaa218e070

	measure 'Total Revenue' = SUM ( fct_trips_hourly[total_fare_sum] )
		lineageTag: fa60a099-6672-41d5-8d54-aa4e69f046e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Fare per Trip' = DIVIDE ( [Total Revenue], [Total Trips] )
		lineageTag: a808d5ef-c5ef-4064-985a-f2503b88b4eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Wait Time (min)' = ```

			        DIVIDE ( SUM ( fct_trips_hourly[wait_time_seconds_sum] ), SUM ( fct_trips_hourly[wait_time_trips] ) ) / 60
			```
		lineageTag: aa285eab-b6b7-4bc6-a1d5-8461402ebd4d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Driver Pay' = SUM ( fct_trips_hourly[driver_pay_sum] )
		lineageTag: 050dfffb-8da7-43a8-a6d2-01883176b3d6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Driver Pay Share %' = DIVIDE ( [Driver Pay], [Total Revenue] )
		lineageTag: 59d4e3d3-d7a0-40ce-a89c-fc6e6a676100

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trips Previous Month' = ```

			        CALCULATE ( [Total Trips], DATEADD ( dim_date[date], -1, MONTH ) )
			```
		formatString: 0
		lineageTag: d8fad0a4-7f37-4e1d-a0ed-5605d3223b53

	measure 'MoM Trip Growth %' = ```

			        VAR tripsNow = [Total Trips]
			        VAR tripsBefore = [Trips Previous Month]
			        RETURN IF ( NOT ISBLANK ( tripsNow ) && NOT ISBLANK ( tripsBefore ), DIVIDE ( tripsNow - tripsBefore, tripsBefore ) )
			```
		lineageTag: 590904ed-e6e7-41f0-b459-a6155f1dd87c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Company Revenue Share %' = ```

			        DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALL ( dim_company ) ) )
			```
		lineageTag: 164b3cc9-218c-4940-82b1-7c7433d83f48

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Airport Pickups' = ```

			        CALCULATE ( [Total Trips], dim_zone[is_airport] = TRUE () )
			```
		formatString: 0
		lineageTag: 350cdfe6-7923-43b1-a147-dca4a82bbcd4

	measure 'Weekday Peak Share %' = ```

			        DIVIDE (
			            CALCULATE ( [Total Trips], dim_time[is_peak_hour] = TRUE (), dim_date[is_weekend] = FALSE () ),
			            CALCULATE ( [Total Trips], dim_date[is_weekend] = FALSE () )
			        )
			```
		lineageTag: 20fe1861-13a2-40be-a0e3-cf85f9a37b75

		annotation PBI_FormatHint = {"isGeneralNumber":true}

